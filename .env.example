# Copy to .env.local for local development (this file is only a template).
# Only NON-SECRET values belong here: EXPO_PUBLIC_* variables are embedded in the app bundle.

# "mock" = local dummy data (default in development builds). "live" = Google Apps Script backend.
EXPO_PUBLIC_DATA_MODE=mock

# Required when EXPO_PUBLIC_DATA_MODE=live. The deployed Apps Script web app URL (it is not a secret).
# EXPO_PUBLIC_API_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
